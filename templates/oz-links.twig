{# Renders "Label|URL, Label|URL" settings as links. Vars: list (string), cls (optional class) #}
{% for link in list|default('')|split(',') %}
  {% set parts = link|split('|') %}
  {% if parts|length == 2 and parts[0]|trim %}<a {% if cls is defined and cls %}class="{{ cls }}"{% endif %} href="{{ parts[1]|trim }}">{{ parts[0]|trim }}</a>{% endif %}
{% endfor %}
