{#
  OZ add-on: Rank Preview (3D skin preview, rank ladder, "your current rank" picker, rank comparison table).
  Included by category.html with "ignore missing"; without this file the ranks category shows the normal package grid.
  Files: oz-addon-ranks.twig, oz-preview.twig, oz-addon-ranks-js.twig (Twig assets) + oz-preview.js (JavaScript asset).
#}
{# ---------- Rank comparison table ---------- #}
{% set rows = config('rank-table')|split("\n") %}
{% set hot  = (config('rank-highlight') ? config('rank-highlight') : '')|replace({' ': ''})|lower %}
{% set skinName = basket.ign ? basket.ign : (config('preview-skin') ? config('preview-skin') : 'MHF_Steve') %}
{% set skinLabel = basket.ign ? basket.ign : __('You') %}
{# Pick the rank shown first: the highlighted one, else the first package that has a style #}
{% set pick = false %}{% set pickPrefix = '' %}{% set pickColor = '#FFFFFF' %}{% set styled = 0 %}
{% for package in packages %}
  {% for line in styleLines %}{% set p = line|split('|') %}
    {% if p|length >= 2 and p[0]|replace({' ': ''})|lower == package.name|replace({' ': ''})|lower %}
      {% set styled = styled + 1 %}
      {% if not pick or package.name|replace({' ': ''})|lower == hot %}{% set pick = package.name %}{% set pickPrefix = p[1] %}{% set pickColor = p|length > 2 ? p[2]|replace({' ': ''}) : '#FFFFFF' %}{% endif %}
    {% endif %}
  {% endfor %}
{% endfor %}
{% if (config('rank-preview') ? config('rank-preview') : 'show')|lower == 'show' and styled %}
  {% if pick %}
  <section class="oz-rankhero" aria-label="{{ __('Rank preview') }}">
    <div class="oz-panel oz-rankhero__stage">
      {% set pvSkin = skinName %}{% set pvLabel = skinLabel %}{% set pvPrefix = pickPrefix %}{% set pvColor = pickColor %}{% set pvName = pick %}{% set pvPackages = packages %}
      {% include "oz-preview.twig" %}
    </div>
    <div class="oz-panel oz-rankhero__info">
      <div class="oz-label">{{ __('Rank preview') }}</div>
      <h2 data-oz-preview-name>{{ pick }}</h2>
      <p class="oz-muted oz-m0">{{ basket.ign ? __('This is exactly how you will look in-game.') : __('Log in to see it on your own skin.') }}</p>
      {# "Your current rank": the player says which rank they own (Tebex does not tell the theme).
         Remembered in their browser per username. Ranks are assumed to be listed lowest → highest. #}
      {% if basket.ign and (config('rank-current-picker') ? config('rank-current-picker') : 'on')|lower == 'on' %}
      <div class="oz-slot oz-myrank" data-oz-myrank data-ign="{{ basket.ign|lower }}">
        <label class="oz-label" for="oz-myrank-sel">{{ __('Your current rank') }}</label>
        <select class="oz-input oz-myrank__sel" id="oz-myrank-sel">
          <option value="">{{ __('None yet') }}</option>
          {% for package in packages %}<option value="{{ package.name|lower }}">{{ package.name }}</option>{% endfor %}
        </select>
        <p class="oz-myrank__status" data-oz-upgrade aria-live="polite"></p>
        <small class="oz-muted">{{ __('Saved on this device only. We can’t see your in-game rank, so pick it here.') }}</small>
      </div>
      {% endif %}
      {% if (config('rank-ladder') ? config('rank-ladder') : 'on')|lower == 'on' %}
      <div class="oz-ladder" aria-label="{{ __('Rank ladder') }}">
        {% set step = 0 %}
        {% for package in packages %}
          {% for line in styleLines %}{% set p = line|split('|') %}
            {% if p|length >= 2 and p[0]|replace({' ': ''})|lower == package.name|replace({' ': ''})|lower %}{% set col = p|length > 2 ? p[2]|replace({' ': ''}) : '#FFFFFF' %}
          <a class="oz-ladder__step" href="#oz-rank-table" data-oz-rank="{{ package.name|lower }}"><span class="oz-ladder__bar" style="height:{{ 30 + step * (90 / styled) }}px;background:{{ col }}"></span><b style="color:{{ col }}">{{ package.name }}</b><small class="oz-muted">{{ package.price|money }} {{ basket.currency }}</small></a>
            {% set step = step + 1 %}{% endif %}
          {% endfor %}
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </section>
  {% endif %}
{% endif %}
<div class="oz-panel oz-ranks" id="oz-rank-table">
  <table>
    <thead>
      <tr>
        <th style="vertical-align:bottom;width:24%"><span class="oz-label">{{ __('Compare') }}</span></th>
        {% for package in packages %}
          <th class="{% if package.name|replace({' ': ''})|lower == hot %}is-hot{% endif %}" data-oz-rank="{{ package.name|lower }}">
            <span class="oz-tag oz-tag--b oz-ranks__mine" hidden>{{ __('Your rank') }}</span>
            {% if package.name|replace({' ': ''})|lower == hot %}<span class="oz-tag oz-ranks__hot">{{ __('Most popular') }}</span>{% endif %}
            <span class="oz-slot">{% if package.image is defined and package.image and package.image.url %}<img src="{{ package.image.url }}" alt="">{% else %}<span class="oz-ico oz-ico--lg oz-ico--crown"></span>{% endif %}</span>
            <h3>{{ package.name }}</h3>
            <div class="oz-price">
              {% if package.discount is defined and package.discount.applied %}<s>{{ package.discount.original|money }}</s>{% endif %}
              <strong>{{ package.price|money }}</strong><small>{{ basket.currency }}</small>
            </div>
            {% if package.quantity is defined and package.quantity > 0 %}
              <a class="oz-btn oz-btn--alt oz-btn--sm" href="/checkout/packages/remove/{{ package.id }}">{{ __('In basket') }} &times;</a>
            {% else %}
              <a class="oz-btn oz-btn--sm" href="/checkout/packages/add/{{ package.id }}/single">{{ __('Buy') }}</a>
            {% endif %}
          </th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      {% for row in rows %}
        {% set cells = row|split('|') %}
        {% if cells|length > 1 %}
          <tr>
            <td>{{ cells[0] }}</td>
            {% for package in packages %}
              {% set v = cells|length > loop.index ? cells[loop.index] : '' %}{% set vk = v|replace({' ': ''})|lower %}
              <td class="{% if package.name|replace({' ': ''})|lower == hot %}is-hot{% endif %}" data-oz-rank="{{ package.name|lower }}">
                {% if vk in ['yes','y','true','✓'] %}<span class="yes" aria-label="{{ __('Included') }}">✓</span>
                {% elseif vk in ['no','n','false','-','—',''] %}<span class="no" aria-label="{{ __('Not included') }}">✕</span>
                {% else %}{{ v }}{% endif %}
              </td>
            {% endfor %}
          </tr>
        {% endif %}
      {% endfor %}
    </tbody>
  </table>
</div>

